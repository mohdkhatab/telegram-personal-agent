# Copy this file as .env and fill it in. NEVER share .env or commit it.
# ---------------------------------------------------------------------------
# Telegram app credentials — from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# ---------------------------------------------------------------------------
# AI provider — ANY OpenAI-compatible API works.
# Set AI_PROVIDER to a preset, or "custom" + your own AI_BASE_URL.
#
#   bridge      Local Muse Bridge          http://127.0.0.1:4010/v1   (no real key needed)
#   openrouter  OpenRouter                  https://openrouter.ai/api/v1
#   openai      OpenAI                      https://api.openai.com/v1
#   groq        Groq                        https://api.groq.com/openai/v1
#   ollama      Local Ollama                http://127.0.0.1:11434/v1   (no key needed)
#   custom      Your own endpoint           set AI_BASE_URL yourself
AI_PROVIDER=bridge
AI_API_KEY=
# Optional overrides (win over the preset):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Who gets a reply?
# Private chats: all_private = everyone | whitelist = only AGENT_WHITELIST ids
AGENT_MODE=all_private
AGENT_WHITELIST=
# Groups: all = every group message | mention = only @mention / reply-to-you /
# trigger words | off = no group replies. Busy groups are protected by a
# per-group cooldown (seconds) so the agent never spams.
AGENT_GROUPS=all
GROUP_COOLDOWN_SEC=8
GROUP_TRIGGERS=prime,primekhatab
